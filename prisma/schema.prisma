generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  admin
  collector

  @@map("user_roles")
}

enum MaterialUnit {
  kg
  piece

  @@map("material_units")
}

enum PickupStatus {
  pending
  assigned
  on_the_way
  arrived
  completed
  cancelled

  @@map("pickup_statuses")
}

enum PayoutStatus {
  pending
  paid
  cancelled

  @@map("payout_statuses")
}

model User {
  id            Int       @id @default(autoincrement())
  full_name     String
  email         String    @unique
  password_hash String
  role          UserRole  @default(customer)
  last_login_at DateTime? @db.Timestamptz(3)
  created_at    DateTime  @default(now()) @db.Timestamptz(3)
  updated_at    DateTime  @updatedAt @db.Timestamptz(3)

  addresses        Address[]
  pickups          Pickup[]  @relation("CustomerPickups")
  assigned_pickups Pickup[]  @relation("CollectorPickups")
  wallet           Wallet?

  @@map("users")
}

model Governorate {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  cities City[]

  @@map("governorates")
}

model City {
  id             Int      @id @default(autoincrement())
  governorate_id Int
  name           String
  created_at     DateTime @default(now()) @db.Timestamptz(3)
  updated_at     DateTime @updatedAt @db.Timestamptz(3)

  governorate Governorate @relation(fields: [governorate_id], references: [id], onDelete: Restrict)
  addresses   Address[]

  @@unique([governorate_id, name])
  @@map("cities")
}

model Address {
  id           Int      @id @default(autoincrement())
  user_id      Int
  city_id      Int
  address_line String
  building     String?
  floor        String?
  apartment    String?
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  updated_at   DateTime @updatedAt @db.Timestamptz(3)

  user    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  city    City     @relation(fields: [city_id], references: [id], onDelete: Restrict)
  pickups Pickup[]

  @@map("addresses")
}

model Material {
  id            Int          @id @default(autoincrement())
  name          String       @unique
  unit          MaterialUnit
  current_price Decimal      @db.Decimal(10, 2)
  created_at    DateTime     @default(now()) @db.Timestamptz(3)
  updated_at    DateTime     @updatedAt @db.Timestamptz(3)

  pickup_items PickupItem[]

  @@map("materials")
}

model Pickup {
  id            Int          @id @default(autoincrement())
  customer_id   Int
  collector_id  Int?
  address_id    Int
  status        PickupStatus @default(pending)
  note          String?
  payout        Decimal?     @db.Decimal(10, 2)
  payout_status PayoutStatus @default(pending)

  requested_at DateTime  @default(now()) @db.Timestamptz(3)
  completed_at DateTime? @db.Timestamptz(3)
  cancelled_at DateTime? @db.Timestamptz(3)
  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  updated_at   DateTime  @updatedAt @db.Timestamptz(3)

  customer  User         @relation("CustomerPickups", fields: [customer_id], references: [id], onDelete: Restrict)
  collector User?        @relation("CollectorPickups", fields: [collector_id], references: [id], onDelete: SetNull)
  address   Address      @relation(fields: [address_id], references: [id], onDelete: Restrict)
  items     PickupItem[]

  @@map("pickups")
}

model PickupItem {
  id             Int      @id @default(autoincrement())
  pickup_id      Int
  material_id    Int
  price_per_unit Decimal  @db.Decimal(10, 2)
  quantity       Decimal  @db.Decimal(10, 2)
  note           String?
  created_at     DateTime @default(now()) @db.Timestamptz(3)
  updated_at     DateTime @updatedAt @db.Timestamptz(3)

  pickup   Pickup   @relation(fields: [pickup_id], references: [id], onDelete: Cascade)
  material Material @relation(fields: [material_id], references: [id], onDelete: Restrict)

  @@map("pickup_items")
}

model Wallet {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  balance    Decimal  @default(0) @db.Decimal(12, 2)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  user         User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id         Int      @id @default(autoincrement())
  wallet_id  Int
  amount     Decimal  @db.Decimal(12, 2)
  created_at DateTime @default(now()) @db.Timestamptz(3)

  wallet Wallet @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}
